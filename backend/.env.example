# Copy to backend/.env (never commit the real file). Every setting is optional; with none the API serves a simulated demo.

# --- where the data comes from (raw URLs on the `data` branch, written by the "Refresh forecast" workflow) ---
FORECAST_URL=https://raw.githubusercontent.com/<you>/<repo>/data/forecast.json
ALERTS_URL=https://raw.githubusercontent.com/<you>/<repo>/data/alerts.json
FORWARD_LOG_URL=https://raw.githubusercontent.com/<you>/<repo>/data/forward_log.csv
FORECAST_CACHE_S=120

# --- the website that may call this API (CORS) ---
FRONTEND_ORIGIN=https://<your-site>.vercel.app
# FRONTEND_ORIGIN_REGEX=https://.*\.vercel\.app

# --- admin endpoints (/api/admin/*): off unless this is set to at least 16 characters ---
# generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- storage and background work ---
# the alert history is kept in SQLite; "off" disables it. Only SQLite is built in (see docs/DEPLOY.md).
DATABASE_URL=sqlite:///data/flarenet.db
# poll the sources in the background (on by default when FORECAST_URL or ALERTS_URL is set; 0 turns it off)
FLARENET_BACKGROUND=
INGEST_INTERVAL_S=300
LOG_LEVEL=INFO
